<Window x:Class="ICR_2022_2023_Mapa_dogadjaja.View.EventType.AllEventTypesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ICR_2022_2023_Mapa_dogadjaja.View.EventType"
        mc:Ignorable="d"
        Title="Svi tipovi događaja" Height="600" Width="1280" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <!-- Screen resolution:      Height="768" Width="1366" -->
    <!-- Main window resolution: Height="680" Width="1240" -->
    <DockPanel LastChildFill="True" Margin="10 0 10 0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Margin="0 10 0 10">
            <Button x:Name="Create_a_new_event_type_button" Margin="0 0 10 0" Click="OpenDialogForCreatingANewEventType">Novi tip događaj (Ctrl + N)</Button>
            <Button x:Name="Edit_an_event_type_button" Margin="0 0 10 0" Click="OpenDialogForEditingAnEventType">Izmeni (Ctrl + E)</Button>
            <Button x:Name="Delete_an_event_type_button" Margin="0 0 10 0" Click="OpenDialogForDeletingAnEntity">Obriši (Ctrl + Delete)</Button>
        </StackPanel>
        <DataGrid x:Name="Table_of_event_types" ItemsSource="{Binding AllEntitiesViewModel.EventTypesViewModel.EventTypes}" 
                  IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False" CanUserResizeColumns="False" 
                  CanUserResizeRows="False" VerticalScrollBarVisibility="Visible" HorizontalContentAlignment="Left" 
                  VerticalContentAlignment="Stretch" AutoGenerateColumns="False" SizeChanged="Table_of_event_types_SizeChanged" 
                  RowHeight="64">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Oznaka" Binding="{Binding Id}" MinWidth="15"></DataGridTextColumn>
                <!-- REFERENCE: https://girishzalke.com/2017/01/12/display-images-in-wpf-data-grid/ -->
                <DataGridTemplateColumn Header="Ikona" MinWidth="10">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Icon}" Stretch="Uniform"></Image>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" MinWidth="20"></DataGridTextColumn>
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" MinWidth="55"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
