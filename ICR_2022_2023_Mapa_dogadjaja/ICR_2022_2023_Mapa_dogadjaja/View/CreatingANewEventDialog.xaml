<Window x:Class="ICR_2022_2023_Mapa_dogadjaja.View.CreatingANewEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:model="clr-namespace:ICR_2022_2023_Mapa_dogadjaja.Model"
        xmlns:local="clr-namespace:ICR_2022_2023_Mapa_dogadjaja.View"
        xmlns:view_model="clr-namespace:ICR_2022_2023_Mapa_dogadjaja.ViewModel"
        mc:Ignorable="d"
        Title="Unos i izmena događaja" Height="680" Width="800" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
        <!-- Screen resolution:      Height="768" Width="1366" -->
        <!-- Main window resolution: Height="680" Width="1240" -->
    <Grid Margin="10 0 10 0">
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left" Width="60">Oznaka:</Label>
            <TextBox x:Name="Input_for_id"></TextBox>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left" Width="60">Etikete:</Label>
            <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox DockPanel.Dock="Left" x:Name="Combo_box_for_event_tags" ItemsSource="{Binding MainWindow.EventTags}" 
                          Margin="0 0 10 0" Width="560"></ComboBox>
                <Button x:Name="Create_a_new_event_tag_button">Unesite novu etiketu</Button>
            </DockPanel>
        </DockPanel>
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left" Width="60">Naziv:</Label>
            <TextBox x:Name="Input_for_name"></TextBox>
        </DockPanel>
        <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left" Width="60">Opis:</Label>
            <RichTextBox x:Name="Input_for_decription"></RichTextBox>
        </DockPanel>
        <DockPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left" Width="60">Tip:</Label>
            <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox DockPanel.Dock="Left" x:Name="Combo_box_for_event_type" ItemsSource="{Binding MainWindow.EventTypes}" 
                          Margin="0 0 10 0" Width="560"></ComboBox>
                <Button x:Name="Create_a_new_event_type_button">Unesite novi tip</Button>
            </DockPanel>
        </DockPanel>
        <DockPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Posećenost događaja:</Label>
            <!-- REFERENCE: https://brianlagunas.com/a-better-way-to-data-bind-enums-in-wpf/ -->
            <ComboBox x:Name="Combo_box_for_attendance" 
                      ItemsSource="{Binding Source={view_model:EnumBindingSource {x:Type model:Attendance}}}" SelectedIndex="0"></ComboBox>
        </DockPanel>
        <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Ikona:</Label>
            <Button x:Name="Add_icon_button">Odaberite ikonu</Button>
        </DockPanel>
        <DockPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Humanitarnog karaktera:</Label>
            <WrapPanel x:Name="IsHumanitary_radio_buttons_group" HorizontalAlignment="Left" VerticalAlignment="Center">
                <RadioButton x:Name="IsHumanitary_option_Yes_radio_button" Margin="0 0 20 0">Da</RadioButton>
                <RadioButton x:Name="IsHumanitaty_option_No_radio_button">Ne</RadioButton>
            </WrapPanel>
        </DockPanel>
        <DockPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Prosečna cena troškova za održavanje:</Label>
            <TextBox x:Name="Input_for_average_costs_of_sustension"></TextBox>
        </DockPanel>
        <DockPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Grad:</Label>
            <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox DockPanel.Dock="Left" x:Name="Combo_box_for_populated_place" 
                          ItemsSource="{Binding MainWindow.PopulatedPlaces}" Margin="0 0 10 0" Width="560"></ComboBox>
                <Button x:Name="Create_a_new_populated_place_button">Unesite novi grad</Button>
            </DockPanel>
        </DockPanel>
        <DockPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Država:</Label>
            <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox DockPanel.Dock="Left" x:Name="Combo_box_for_country" ItemsSource="{Binding MainWindow.Countries}" 
                          Margin="0 0 10 0" Width="560"></ComboBox>
                <Button x:Name="Create_a_new_country_button">Unesite novu državu</Button>
            </DockPanel>
        </DockPanel>
        <DockPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Istorija datuma održavanja:</Label>
            <ListBox x:Name="Input_for_history_of_dates_of_the_event"></ListBox>
        </DockPanel>
        <DockPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Label DockPanel.Dock="Left">Datum održavanja:</Label>
            <DatePicker x:Name="Input_for_date_of_the_event"></DatePicker>
        </DockPanel>
        <Button Grid.Row="13" Grid.Column="0" x:Name="Save_button" Height="30" Width="100">Sačuvaj</Button>
        <Button Grid.Row="13" Grid.Column="1" x:Name="Cancel_button" Height="30" Width="100" Click="CloseDialog">Otkaži</Button>
    </Grid>
</Window>
