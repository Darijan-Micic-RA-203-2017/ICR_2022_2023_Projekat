<Window x:Class="ICR_2022_2023_Mapa_dogadjaja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ICR_2022_2023_Mapa_dogadjaja"
        mc:Ignorable="d"
        Title="Mapa događaja" Height="680" Width="1240" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
        <!-- Height="768" Width="1366"-->
    <DockPanel>
        <Menu x:Name="Main_menu" DockPanel.Dock="Top" Background="Black" Foreground="White">
            <MenuItem x:Name="Submenu_Application_of_main_menu" Header="_Aplikacija (Alt + A)" AutomationProperties.AccessKey="A">
                <MenuItem x:Name="Item_Close_of_submenu_Application" Header="Zatvori" Background="Black" Foreground="White" 
                          Click="CloseApplication"></MenuItem>
            </MenuItem>
            <MenuItem x:Name="Submenu_Event_of_main_menu" Header="_Događaj (Alt + D)" AutomationProperties.AccessKey="D">
                <MenuItem x:Name="Item_New_event_of_submenu_Event" Header="Novi događaj" Background="Black" Foreground="White" 
                          Click="OpenDialogForCreatingANewEvent"></MenuItem>
                <MenuItem x:Name="Item_Edit_event_of_submenu_Event" Header="Izmeni događaj" Background="Black" Foreground="White" 
                          Click="OpenDialogForEditingAnEvent"></MenuItem>
                <MenuItem x:Name="Item_Delete_entity_of_submenu_Event" Header="Obriši entitet" Background="Black" Foreground="White" 
                          Click="OpenDialogForDeletingAnEntity"></MenuItem>
                <MenuItem x:Name="Item_All_event_tags_of_submenu_Event" Header="Sve etikete" Background="Black" Foreground="White" 
                          Click="OpenDialogForAllEventTags"></MenuItem>
                <MenuItem x:Name="Item_All_event_types_of_submenu_Event" Header="Svi tipovi događaja" Background="Black" Foreground="White" 
                          Click="OpenDialogForAllEventTypes"></MenuItem>
                <MenuItem x:Name="Item_All_populated_places_of_submenu_Event" Header="Svi gradovi" Background="Black" Foreground="White" 
                          Click="OpenDialogForAllPopulatedPlaces"></MenuItem>
                <MenuItem x:Name="Item_All_countries_of_submenu_Event" Header="Sve države" Background="Black" Foreground="White" 
                          Click="OpenDialogForAllCountries"></MenuItem>
            </MenuItem>
            <MenuItem x:Name="Submenu_Help_of_main_menu" Header="_Pomoć (Alt + P)" AutomationProperties.AccessKey="P" 
                      Click="OpenHelpDialog"></MenuItem>
        </Menu>
        <DataGrid x:Name="Table_of_events" ItemsSource="{Binding Events}" IsReadOnly="True" SelectionMode="Single" 
                  AutoGenerateColumns="False" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Oznaka" Binding="{Binding Id}" Width="8"></DataGridTextColumn>
                <DataGridTemplateColumn Header="Ikona" Width="8">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="Image"></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="39"></DataGridTextColumn>
                <DataGridTextColumn Header="Tip" Binding="{Binding Type.Name}" Width="18"></DataGridTextColumn>
                <DataGridTextColumn Header="Datum" Binding="{Binding DateOfTheEvent}" Width="7"></DataGridTextColumn>
                <DataGridTextColumn Header="Grad" Binding="{Binding PopulatedPlace.Name}" Width="10"></DataGridTextColumn>
                <DataGridTextColumn Header="Drzava" Binding="{Binding Country.Name}" Width="10"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
